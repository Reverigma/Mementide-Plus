<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 隐私优先：应用数据完全本地。INTERNET 权限仅用于「设置 → 检查更新」手动触发时查询 GitHub 最新版本与下载 APK，日常不联网。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内下载新版 APK 后唤起系统安装界面所需（Android 8+ 未知来源安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.reverigma.mementideplus.MementidePlusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mementide">
        <activity
            android:name="com.reverigma.mementideplus.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mementide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.reverigma.mementideplus.widget.HabitWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <receiver
            android:name="com.reverigma.mementideplus.reminder.ReminderReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.reverigma.mementideplus.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
